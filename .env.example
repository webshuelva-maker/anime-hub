# Copia este archivo como .env.local y rellena tu clave.
# Consíguela gratis en https://build.nvidia.com (sin tarjeta de crédito):
# inicia sesión → abre cualquier modelo → "Get API Key" → empieza por "nvapi-".
NVIDIA_API_KEY=

# Modelo a usar (cualquiera del catálogo de build.nvidia.com/models).
# Este es un buen equilibrio entre velocidad y calidad para un asistente de chat.
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
