# Copia este archivo como .env.local y rellena tu clave.
# Consíguela gratis en https://console.groq.com (sin tarjeta de crédito):
# regístrate → API Keys → Create API Key. Empieza por "gsk_".
GROQ_API_KEY=
# Con esta misma clave funciona también la investigación en internet de
# Ren (usa "groq/compound", el sistema de Groq que lleva búsqueda web
# integrada). No hace falta contratar ni configurar ningún buscador.

# Backend real (cuentas de usuario + estado premium).
# Consíguelas gratis en https://supabase.com — crea un proyecto → Project
# Settings → Data API. Después de pegarlas aquí, hay que ejecutar
# supabase/schema.sql en el SQL Editor de tu proyecto (una sola vez).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Avisos push (notificar al administrador cuando alguien abre una consulta).
# Las claves VAPID se generan una sola vez con:  npx web-push generate-vapid-keys
# La pública puede ir en el navegador; la privada NUNCA.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Clave "service_role" de Supabase (Project Settings -> API Keys).
# Se salta las políticas de seguridad, así que SOLO se usa en el servidor
# y no debe aparecer nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
